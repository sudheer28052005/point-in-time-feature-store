# Copy to .env and edit. .env is git-ignored. Never commit real credentials.

# --- SQL Server connection ---------------------------------------------------
# Named instance example: localhost\SQLEXPRESS (leave PORT empty; SQL Browser resolves it)
# Default instance / Docker: localhost  with PORT=1433
SQL_SERVER_HOST=localhost\SQLEXPRESS
SQL_SERVER_PORT=
SQL_SERVER_DATABASE=CustomerFeatureStore
# Leave USERNAME/PASSWORD empty to use Windows Authentication (Trusted_Connection).
SQL_SERVER_USERNAME=
SQL_SERVER_PASSWORD=
SQL_SERVER_DRIVER=ODBC Driver 18 for SQL Server
# Driver 18 encrypts by default. Keep ENCRYPT=yes.
SQL_SERVER_ENCRYPT=yes
# LOCAL DEV ONLY: a fresh local instance uses a self-signed certificate, so the
# client cannot validate it. Set to yes for localhost; use no (and a real
# certificate) for any remote server.
SQL_SERVER_TRUST_CERTIFICATE=yes

# Optional timeouts (seconds; 0 = no query timeout) and pool size
SQL_SERVER_LOGIN_TIMEOUT=15
SQL_SERVER_QUERY_TIMEOUT=0
SQL_SERVER_POOL_SIZE=5

# Optional: run the dashboard as a restricted SQL login (see sql/15_dashboard_readonly_role.sql).
# Leave empty to reuse the connection above.
DASHBOARD_SQL_USERNAME=
DASHBOARD_SQL_PASSWORD=

# Only for docker-compose.yml (untested optional path)
MSSQL_SA_PASSWORD=

# --- Synthetic data ----------------------------------------------------------
RANDOM_SEED=42
NUM_USERS=50000
NUM_ORDERS=200000
NUM_EVENTS=1000000
BATCH_SIZE=10000

# --- Feature pipeline --------------------------------------------------------
# Default feature cutoff (UTC date, exclusive-upper-bound contract; see README).
FEATURE_CUTOFF_DATE=2025-06-30
